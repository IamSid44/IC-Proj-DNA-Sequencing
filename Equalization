from manim import *

class LineGraphExample(Scene):
    def construct(self):
        # Create axes
        axes = Axes(
            x_range=[0, 5, 1],  # [min, max, step]
            y_range=[0, 5, 1],
            axis_config={"color": BLUE},  # Color of axes
        )
        
        # Add axis labels
        x_label = axes.get_x_axis_label("States", edge=RIGHT, direction=DOWN)
        y_label = axes.get_y_axis_label("Current\ Levels", edge=UP, direction=LEFT)
        y_label.shift(UP*0.5)
        x_label.shift(DOWN*0.3)
        
        # Data for the line graph
        x_values = [1, 2, 3, 4]
        y_values = [0, 3, 1, 2]

        # Create a line graph
        line_graph = axes.plot_line_graph(x_values, y_values, line_color=RED, add_vertex_dots=True)

        # Create a collection of vertical dotted lines
        dotted_lines = VGroup()
        
        # Loop over x-values and y-values to create dotted lines
        for x, y in zip(x_values, y_values):
            # Start from x-axis to the specified y-value
            start_point = axes.c2p(x, x-0.5)  # Start at the x-axis
            end_point = axes.c2p(x, x)  # End at the y-value
            
            # Create the dotted line
            dotted_line = DashedLine(
                start=start_point,
                end=end_point,
                dash_length=0.1,  # Length of individual dashes
                dashed_ratio=0.5,  # Ratio of dash to space
                stroke_width=3,  # Line thickness
                color=RED,  # Line color
            )
            
            dotted_lines.add(dotted_line)

         # Rectangle spanning the defined area
        highlight_rect1 = Rectangle(
            width=axes.x_length,  # Full width of the x-axis
            height=axes.c2p(0, 1)[1] - axes.c2p(0, 0.5)[1],  # Rectangle height
            fill_color=YELLOW,  # Color of the rectangle
            fill_opacity=0.3,  # Opacity level
            stroke_width=1,  # No border around the rectangle
        )

        # Position the rectangle to start at the desired y-coordinate
        highlight_rect1.move_to(
            axes.c2p((axes.x_range[1] - axes.x_range[0]) / 2, (0.5 + 1.0) / 2)  # Centered in the specified range
        )

        highlight_rect2 = Rectangle(
            width=axes.x_length,  # Full width of the x-axis
            height=axes.c2p(0, 1.5)[1] - axes.c2p(0, 2.0)[1],  # Rectangle height
            fill_color=BLUE,  # Color of the rectangle
            fill_opacity=0.3,  # Opacity level
            stroke_width=1,  # No border around the rectangle
        )

        # Position the rectangle to start at the desired y-coordinate
        highlight_rect2.move_to(
            axes.c2p((axes.x_range[1] - axes.x_range[0]) / 2, (1.5 + 2.0) / 2)  # Centered in the specified range
        )

        highlight_rect3 = Rectangle(
            width=axes.x_length,  # Full width of the x-axis
            height=axes.c2p(0, 2.5)[1] - axes.c2p(0, 3.0)[1],  # Rectangle height
            fill_color=GREEN,  # Color of the rectangle
            fill_opacity=0.3,  # Opacity level
            stroke_width=1,  # No border around the rectangle
        )

        # Position the rectangle to start at the desired y-coordinate
        highlight_rect3.move_to(
            axes.c2p((axes.x_range[1] - axes.x_range[0]) / 2, (2.5 + 3.0) / 2)  # Centered in the specified range
        )

        highlight_rect4 = Rectangle(
            width=axes.x_length,  # Full width of the x-axis
            height=axes.c2p(0, 3.5)[1] - axes.c2p(0, 4.0)[1],  # Rectangle height
            fill_color=ORANGE,  # Color of the rectangle
            fill_opacity=0.3,  # Opacity level
            stroke_width=1,  # No border around the rectangle
        )

        # Position the rectangle to start at the desired y-coordinate
        highlight_rect4.move_to(
            axes.c2p((axes.x_range[1] - axes.x_range[0]) / 2, (3.5 + 4.0) / 2)  # Centered in the specified range
        )


        # Display the axes and dotted lines in the scene
        self.play(Create(axes), run_time = 3)
        self.play(Write(x_label),Write(y_label))
        self.play(Create(dotted_lines), run_time = 2)

        # Pause to view the result
        Omega = MathTex(r"\Omega", r":\ original\ space")
        Omega.move_to(UP*3)

        self.wait(1)

        self.play(FadeIn(highlight_rect1), run_time = 1)
        self.wait(0.5)

        self.play(FadeIn(highlight_rect2), run_time = 1)
        self.wait(0.5)

        self.play(FadeIn(highlight_rect3), run_time = 1)
        self.wait(0.5)

        self.play(FadeIn(highlight_rect4), run_time = 1)
        self.wait(1)
        self.play(Write(Omega))

        self.play(highlight_rect3.animate.shift(DOWN*0.4), dotted_lines[2].animate.shift(DOWN*0.4))

        self.wait(1)

        self.play(highlight_rect2.animate.shift(UP*0.4), dotted_lines[1].animate.shift(UP*0.4))

        self.wait(1)

        spacetext = Omega[1]
        rep_text = Tex(r"\ x\ \{No Err,Del\} = $\Omega$' ")

        rep_text.next_to(Omega[0], RIGHT)
        self.play(ReplacementTransform(spacetext, rep_text))

        self.wait(3)

