from manim import*

class ThreeDParametricSpring2(ThreeDScene):
    def construct(self):
        curve1 = ParametricFunction(
            lambda u: np.array([
                u * 0.5,
                0.6 * np.cos(u),
                0.6 * np.sin(u)
            ]), color=RED, t_range = np.array([-3*TAU, -0.40 * TAU, 0.01])
        ).set_shade_in_3d(True)

        curve2 = ParametricFunction(
            lambda u: np.array([
                u * 0.5,
                0.6 * np.cos(u) * -1,
                0.6 * np.sin(u) * -1
            ]), color=GREEN, t_range = np.array([-3*TAU, -0.40 * TAU, 0.01])
        ).set_shade_in_3d(True)
        axes=ThreeDAxes()

        rect=Rectangle(width=2.5, height=1.5, fill_color=WHITE, fill_opacity = 0)
        self.add_fixed_in_frame_mobjects(rect)
        Boxtext = Text("Sequencer", color=WHITE, font_size=30)
        self.add_fixed_in_frame_mobjects(Boxtext)

        sequence_str = "TAGGATGCATGTAGTAC"
        seq = Text("", font_size=50, color=RED)

        self.add(curve1, curve2)

        for u in range(-20, -2):
            l = Line([u * 0.5, 0.6 * np.cos(u), 0.6 * np.sin(u)], [u * 0.5, -0.6 * np.cos(u), -0.6 * np.sin(u)])
            self.add(l)
            
        self.set_camera_orientation(phi=0 * DEGREES)
        self.begin_ambient_camera_rotation(rate = 6.5, about="phi")
        i = 1.3
        s = ""
        for char in sequence_str:
            # c = Tex(char).shift(RIGHT*i).scale(1.2)
            s = char + s
            i = i + 0.18
            str = Tex(s).shift(RIGHT*i)
            self.add_fixed_in_frame_mobjects(str)
            # self.play(Transform(seq, Text(seq.text, font_size=50, color=RED)))
            # self.play(Create(c))
            # seq.move_to()
            self.wait(0.2)
            self.remove(str)

        self.wait(1)
