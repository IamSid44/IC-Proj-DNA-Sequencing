from manim import *

class NeuralNetwork(Scene):
    def construct(self):

        # Define neuron circles
        neuron_radius = 0.6
        neurons_layer1 = VGroup(*[Circle(radius=neuron_radius, stroke_color=WHITE, stroke_width=3) for _ in range(4)])
        neurons_layer1.arrange(DOWN, buff=0.8)  # Arrange vertically

        neurons_layer2 = VGroup(*[Circle(radius=neuron_radius, stroke_color=WHITE, stroke_width=3) for _ in range(3)])
        neurons_layer2.arrange(DOWN, buff=0.8)

        # Combine layers into a single VGroup for scaling
        network_layers = VGroup(neurons_layer1, neurons_layer2)

        # Move layers to desired positions
        network_layers.move_to(RIGHT * 0.5)  # Adjust position as needed
        neurons_layer1.move_to(neurons_layer1.get_center() - RIGHT * 3)
        neurons_layer2.move_to(neurons_layer2.get_center() - LEFT * 3)

        # Define connections as lines with origin at neuron centers
        connections_l1_l2 = VGroup()
        for i in range(4):
            for j in range(3):
                start_dot = neurons_layer1[i].get_center()
                end_dot = neurons_layer2[j].get_center()
                connection = Line(start_dot, end_dot, color=WHITE, stroke_width=2)
                connections_l1_l2.add(connection)

        # Animate with gradual appearance
        self.play(Create(network_layers, run_time=2, lag_factor=0.8))
        self.play(Create(connections_l1_l2))

        nn = VGroup(network_layers, connections_l1_l2)

        self.play(nn.animate.scale(0.8))
        

        # Create transparent bounding box (no fill color)
        bounding_box = Rectangle(stroke_opacity=0.7)  # Remove fill_opacity

        # Calculate bounding box dimensions with padding
        padding = 0.5  # Adjust padding as needed
        bounding_box_width = network_layers.get_width() - padding
        bounding_box_height = network_layers.get_height() + padding
        bounding_box.set_width(bounding_box_width)
        bounding_box.set_height(bounding_box_height)

        # Center bounding box on network layers
        bounding_box.move_to(network_layers.get_center())

        self.play(Create(bounding_box))

        # Create label "basecaller"
        label = Text("basecaller", font_size=36, color=BLUE)
        label.move_to(network_layers.get_top() + UP * 0.5)  # Position abov
        self.play(FadeIn(label))
        self.wait(2)
