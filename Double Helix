        "light_source": 15 * DOWN + 7 * LEFT + 10 * OUT,
        "number_line_config": {
            "include_tip": False,
        },
      }

    # Define the parametric function (replace this with your desired function)
    def func(self,t):
      x = t * 2
      y = np.sin(t)
      z = np.cos(t)
      
      if(t%1.0 == 0):
        line = Line3D(start=np.array[x, 0, 0], end=np.array[x, y, z])
        self.add(line)
      
      return np.array([x, y, z])  # Adjust for 3D if needed (set z to 0 for 2D)
    
    def func2(self,t):
      x = t * 2
      y = np.sin(t) * -1
      z = np.cos(t) * -1 
      
      if(t%1.0 == 0):
        line = Line3D(start=np.array[x, 0, 0], end=np.array[x, y, z])
        self.add(line)
      
      return np.array([x, y, z])  # Adjust for 3D if needed (set z to 0 for 2D)

    # Create the parametric function object
    parametric_curve2 = ParametricFunction(func, t_range=[-25, 25], stroke_width=2)  # Adjust t_range as needed
    parametric_curve = ParametricFunction(func2, t_range=[-25, 25], stroke_width=2)  # Adjust t_range as needed

    # Add the curve to the scene (optional: set color with .set_color(RED))
    #self.set_camera_orientation(phi=0 * DEGREES, theta=0 * DEGREES)
    self.play(Create(parametric_curve), Create(parametric_curve2), run_time=5)

