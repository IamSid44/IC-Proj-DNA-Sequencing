from manim import*

class ThreeDParametricSpring(ThreeDScene):
    def construct(self):
        curve1 = ParametricFunction(
            lambda u: np.array([
                u * 1,
                1.2 * np.cos(u),
                1.2 * np.sin(u)
            ]), color=RED, t_range = np.array([-3*TAU, 5*TAU, 0.01])
        ).set_shade_in_3d(True)

        curve2 = ParametricFunction(
            lambda u: np.array([
                u * 1,
                1.2 * np.cos(u) * -1,
                1.2 * np.sin(u) * -1
            ]), color=GREEN, t_range = np.array([-3*TAU, 5*TAU, 0.01])
        ).set_shade_in_3d(True)
        axes=ThreeDAxes()

        self.play(Create(curve1), Create(curve2))

        for u in range(-100, 100):
            l = Line([u * 1, 1.2 * np.cos(u), 1.2 * np.sin(u)], [u * 1, -1.2 * np.cos(u), -1.2 * np.sin(u)])
            self.add(l)

        self.set_camera_orientation(phi=0 * DEGREES)
        self.begin_ambient_camera_rotation(rate = 0.6, about="phi")

        self.wait(4)
        
        # self.move_camera(phi=90 * DEGREES)
        # self.stop_ambient_camera_rotation()
